# Copy to apps/web/.env.local and packages/db/.env (both are gitignored).
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=ambient-crm
# Local Docker (pnpm db:up):
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=ambient_crm

# Development-only sign-in. Never enable in a deployed environment.
AMBIENT_DEV_AUTH=1

# AI layer (OpenAI). Server-only secret: never commit a real key.
# Leave unset until the team's key arrives; AI features then show "AI isn't set up yet".
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_MODEL_STRONG=
