{
  "name": "@ambient/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./fixtures": "./src/fixtures.ts",
    "./models": "./src/models.ts",
    "./time": "./src/time.ts"
  },
  "scripts": {
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "indexes": "tsx --env-file-if-exists=.env scripts/indexes.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "inspect": "tsx --env-file-if-exists=.env scripts/inspect.ts"
  },
  "dependencies": {
    "mongodb": "7.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
